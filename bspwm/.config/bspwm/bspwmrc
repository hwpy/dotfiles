#!/bin/sh

#================== ЦВЕТА ==================
ln -sf ~/.config/colors/schemes/$(cat ~/.config/colors/current_scheme).conf ~/.config/colors/current.conf
~/.config/bspwm/bin/update-colors

#================== МОНИТОРЫ ===============
source ~/.config/bspwm/monitors.sh

#================== ТЕМА ДЕСКТОПА (после env) ===============
~/.config/colors/src/apply-gtk-theme
~/.config/bspwm/bin/apply-desktop-theme
~/.config/rofi/src/update-colors
~/.config/dunst/src/update-dunst-colors

#================== BSPWM НАСТРОЙКИ =========
xrandr --output "$INTERNAL_MONITOR" --auto --primary
if xrandr | grep "^${EXTERNAL_MONITOR} connected" >/dev/null; then
    xrandr --output "$EXTERNAL_MONITOR" --auto --right-of "$INTERNAL_MONITOR"
    bspc monitor "$INTERNAL_MONITOR" -d 1 2 3
    bspc monitor "$EXTERNAL_MONITOR" -d 4 5 6
    bspc wm -O "$INTERNAL_MONITOR" "$EXTERNAL_MONITOR"
else
    bspc monitor "$INTERNAL_MONITOR" -d 1 2 3 4 5 6
fi

#================== ПРАВИЛА ОКОН ===========
bspc rule -a Alacritty desktop='^1' follow=on
bspc rule -a DBeaver desktop='^1' state=tiled follow=on
bspc rule -a Chromium desktop='^2' follow=on
bspc rule -a TelegramDesktop desktop='^3' follow=on
bspc rule -a Mattermost desktop='^3' follow=on
bspc rule -a obsidian desktop='^3' follow=on
bspc rule -a firefox desktop='^4' state=tiled follow=on
bspc rule -a libreoffice-startcenter desktop='^4' state=tiled follow=on
bspc rule -a Org.gnome.Evolution desktop='^5' state=tiled follow=on
bspc rule -a ktalk desktop='^5' state=tiled follow=on
bspc rule -a org.remmina.Remmina desktop='^6' state=tiled follow=on

bspc rule -a Xdialog state=floating center=on layer=above
bspc rule -a Dialog state=floating center=on layer=above
bspc rule -a "*Preferences*" state=floating center=on layer=above
bspc rule -a "*properties*" state=floating center=on layer=above

#================== AUTOSTART ==============
pgrep -x sxhkd > /dev/null || sxhkd -m -1 &
feh --bg-fill "$LOCKSCREEN_IMAGE" &
$HOME/.config/polybar/launch_separate.sh &
# $HOME/.config/polybar/launch_single.sh &
flameshot &
udiskie -a -n -t &

# Жесты touchpad (touchegg) — включить: export USE_TOUCHEGG=true в ~/.config/env/env
[ "$USE_TOUCHEGG" = "true" ] && ~/.config/bspwm/bin/touchegg.sh &

#================== BSPWM CONFIG ===========
bspc config focus_follows_pointer false
bspc config window_gap           6
bspc config split_ratio          0.52
bspc config automatic_scheme     spiral
bspc config border_width         $((2 * ${HIDPI_FACTOR:-100} / 100))
bspc config borderless_monocle   true
bspc config gapless_monocle      false

#================== СИСТЕМА ================
xsetroot -cursor_name left_ptr &
for id in $(xinput list | grep 'pointer' | grep -i mouse | sed 's/.*id=\([0-9]*\).*/\1/'); do
    xinput set-prop $id 'libinput Accel Profile Enabled' 0 1 0
    xinput set-prop $id 'libinput Accel Speed' -0.3
done &

case $(ps -p 1 -o comm=) in
  systemd)
    systemctl --user import-environment DISPLAY XAUTHORITY
    systemctl --user restart picom polybar &> /dev/null
    ;;
esac
canberra-gtk-play -i service-login
picom --corner-radius $((9 * ${HIDPI_FACTOR:-100} / 100)) --config ~/.config/picom/picom.conf &
