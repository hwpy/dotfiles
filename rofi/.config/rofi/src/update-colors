#!/bin/bash

source ~/.config/env/env 2>/dev/null || true
F=${HIDPI_FACTOR:-100}
FONT_SIZE=$((11 * F / 100))
WIN_WIDTH=$((467 * F / 100))
PAD=$((10 * F / 100))
EPAD=$((5 * F / 100))
SBW=$((8 * F / 100))
BR=$((9 * F / 100))
WBR=$((9 * F / 100))
FW=$((2 * F / 100))

if echo "$LANG" | grep -q "^ru"; then
    PLACEHOLDER="поиск"
else
    PLACEHOLDER="search"
fi

# Загружаем текущую схему
CURRENT_SCHEME=$(cat ~/.config/colors/current_scheme)
SCHEME_FILE="$HOME/.config/colors/schemes/$CURRENT_SCHEME.conf"

# Парсим цвета
background=$(grep '^background\s*=' "$SCHEME_FILE" | cut -d= -f2 | xargs)
foreground=$(grep '^foreground\s*=' "$SCHEME_FILE" | cut -d= -f2 | xargs)
primary=$(grep '^primary\s*=' "$SCHEME_FILE" | cut -d= -f2 | xargs)
secondary=$(grep '^secondary\s*=' "$SCHEME_FILE" | cut -d= -f2 | xargs)
disabled=$(grep '^disabled\s*=' "$SCHEME_FILE" | cut -d= -f2 | xargs)
alert=$(grep '^alert\s*=' "$SCHEME_FILE" | cut -d= -f2 | xargs)
background_alt=$(grep '^background-alt\s*=' "$SCHEME_FILE" | cut -d= -f2 | xargs)

# Устанавливаем значения по умолчанию
background=${background:-#0F1419}
foreground=${foreground:-#FFFFFF}
primary=${primary:-#7DCFFF}
secondary=${secondary:-#746DFE}
disabled=${disabled:-#5C5A57}
alert=${alert:-#FB3ECE}
background_alt=${background_alt:-#1A1F26}

CONFIG_FILE=~/.config/rofi/config.rasi

sed -i '/@theme/d' "$CONFIG_FILE"

cat > "$CONFIG_FILE" <<EOF
configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Papirus";
    font: "JetBrains Mono Nerd Font ${FONT_SIZE}";
}

* {
    bg0:    ${background};
    bg1:    ${background_alt};
    bg2:    ${secondary};
    bg3:    ${primary};
    fg0:    ${foreground};
    fg1:    ${background};
    fg2:    ${disabled};
    fg3:    ${foreground};

    background-color:   transparent;
    text-color:         @fg0;
    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       center;
    width:          ${WIN_WIDTH}px;
    border-radius:  ${WBR}px;
    background-color:   @bg0;
    border: ${FW}px;
    border-color: @bg2;
}

mainbox {
    padding:    ${PAD}px;
}

inputbar {
    background-color:   @bg1;
    border-color:       @bg3;
    border:         ${FW}px;
    border-radius:  ${BR}px;
    padding:    ${EPAD}px ${PAD}px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg2;
}

entry {
    text-color:         @fg0;
    placeholder:        "${PLACEHOLDER}";
    placeholder-color:  @fg3;
}

message {
    margin:             ${PAD}px 0 0;
    border-radius:      ${BR}px;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    ${EPAD}px ${PAD}px;
}

listview {
    background-color:   transparent;
    margin:     ${PAD}px 0 0;
    lines:      8;
    columns:    1;
    fixed-height: false;
    border: 0px;
}

scrollbar {
    handle-color: @bg2;
    width: ${SBW}px;
}

element {
    background-color:   transparent;
    padding:        ${EPAD}px ${PAD}px;
    spacing:        8px;
    border-radius:  ${BR}px;
}

element normal active {
    background-color: inherit;
    text-color: @fg0;
}

element alternate active {
    background-color: inherit;
    text-color: @fg0;
}

element selected normal, element selected active {
    background-color:   @bg3;
    text-color:         @fg1;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}

element.normal.normal {
    background-color: inherit;
    text-color:       inherit;
}

element.alternate.normal {
    background-color: inherit;
    text-color:       inherit;
}
EOF
