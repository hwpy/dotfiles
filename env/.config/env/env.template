# ===== HIDPI (масштабирование) =====
# Множитель в процентах: 100 = обычный DPI 96 (1920x1080 и т.д.)
# 150 = HiDPI 144 DPI (Retina 2560x1600 13") — оптимально
# 200 = HiDPI 192 DPI (очень крупно, для 4K 15"+)
export HIDPI_FACTOR=100

# ===== ТЕМА (dark / light) =====
# dark  = тёмная тема GTK/Qt приложений
# light = светлая тема GTK/Qt приложений
export THEME_MODE=dark

# ===== МОНИТОРЫ =====
# Узнать названия: xrandr --listmonitors | awk '{print $4}'
export INTERNAL_MONITOR="HDMI-0"
export EXTERNAL_MONITOR="DVI-D-0"

# ===== ЛОКСКРИН =====
# Обои для i3lock/swaylock
# Используется: bspwmrc (feh --bg-fill)
export LOCKSCREEN_IMAGE="$HOME/.config/wlppr/nordic-wallpapers/Minimal-Nord.png"

# ===== POLYBAR: БАТАРЕЯ =====
# Узнать названия: ls /sys/class/power_supply/
export POLYBAR_BATTERY="BAT0"
export POLYBAR_ADAPTER="ADP1"

# ===== POLYBAR: ТЕМПЕРАТУРА CPU =====
# Узнать путь: ls /sys/class/hwmon/*/temp*_input
export POLYBAR_HWMON_PATH="/sys/class/hwmon/hwmon1/temp1_input"

# ===== TOUCHEGG (только на ноутбуке) =====
# Раскомментировать для включения жестов touchpad
# Установка: sudo pacman -S touchegg && sudo systemctl enable --now touchegg.service
# export USE_TOUCHEGG=true

# ===== ТЕМЫ GTK / ИКОНКИ / КУРСОР =====
# Раскомментировать чтобы форсировать ОДНУ тему для всех цветовых схем.
# Если закомментированы — используется значение из текущей цветовой схемы.
# Установить: sudo pacman -S materia-gtk-theme papirus-icon-theme
# export GTK_THEME="Materia-dark"
export ICON_THEME="Papirus-Dark"
export CURSOR_THEME="breeze_cursors"
