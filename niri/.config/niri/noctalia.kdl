layout {

    focus-ring {
        active-color   "#8dcff1"
        inactive-color "#0f1417"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#8dcff1"
        inactive-color "#0f1417"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#8dcff1"
        inactive-color "#004d66"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#8dcff180"
    }
}

recent-windows {
    highlight {
        active-color "#8dcff1"
        urgent-color "#ffb4ab"
    }
}
