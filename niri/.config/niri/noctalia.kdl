layout {

    focus-ring {
        active-color   "#83d2e4"
        inactive-color "#0e1416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#83d2e4"
        inactive-color "#0e1416"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#83d2e4"
        inactive-color "#004e5a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#83d2e480"
    }
}

recent-windows {
    highlight {
        active-color "#83d2e4"
        urgent-color "#ffb4ab"
    }
}
