{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "td_bg": "#0D1119",
    "td_bg_panel": "#0A0D14",
    "td_fg": "#C0CAF5",
    "td_blue": "#7AA2F7",
    "td_purple": "#BB9AF7",
    "td_green": "#9ECE6A",
    "td_red": "#F7768E",
    "td_yellow": "#E0AF68",
    "td_orange": "#FF9E64",
    "td_cyan": "#7DCFFF",
    "td_muted": "#565F89"
  },
  "theme": {
    "primary": { "dark": "td_blue", "light": "td_blue" },
    "secondary": { "dark": "td_purple", "light": "td_purple" },
    "accent": { "dark": "td_orange", "light": "td_orange" },
    "error": { "dark": "td_red", "light": "td_red" },
    "warning": { "dark": "td_yellow", "light": "td_yellow" },
    "success": { "dark": "td_green", "light": "td_green" },
    "info": { "dark": "td_cyan", "light": "td_cyan" },

    "text": { "dark": "td_fg", "light": "td_fg" },
    "textMuted": { "dark": "td_muted", "light": "td_muted" },

    "background": { "dark": "td_bg", "light": "td_bg" },
    "backgroundPanel": { "dark": "td_bg_panel", "light": "td_bg_panel" },
    "backgroundElement": { "dark": "td_bg_panel", "light": "td_bg_panel" },

    "border": { "dark": "td_muted", "light": "td_muted" },
    "borderActive": { "dark": "td_blue", "light": "td_blue" },
    "borderSubtle": { "dark": "td_bg_panel", "light": "td_bg_panel" },

    "diffAdded": { "dark": "td_green", "light": "td_green" },
    "diffRemoved": { "dark": "td_red", "light": "td_red" },
    "diffContext": { "dark": "td_muted", "light": "td_muted" },
    "diffHunkHeader": { "dark": "td_muted", "light": "td_muted" },
    "diffHighlightAdded": { "dark": "td_green", "light": "td_green" },
    "diffHighlightRemoved": { "dark": "td_red", "light": "td_red" },
    "diffAddedBg": { "dark": "td_bg", "light": "td_bg" },
    "diffRemovedBg": { "dark": "td_bg", "light": "td_bg" },
    "diffContextBg": { "dark": "td_bg_panel", "light": "td_bg_panel" },
    "diffLineNumber": { "dark": "td_muted", "light": "td_muted" },
    "diffAddedLineNumberBg": { "dark": "td_bg", "light": "td_bg" },
    "diffRemovedLineNumberBg": { "dark": "td_bg", "light": "td_bg" },

    "markdownText": { "dark": "td_fg", "light": "td_fg" },
    "markdownHeading": { "dark": "td_blue", "light": "td_blue" },
    "markdownLink": { "dark": "td_cyan", "light": "td_cyan" },
    "markdownLinkText": { "dark": "td_cyan", "light": "td_cyan" },
    "markdownCode": { "dark": "td_green", "light": "td_green" },
    "markdownBlockQuote": { "dark": "td_muted", "light": "td_muted" },
    "markdownEmph": { "dark": "td_yellow", "light": "td_yellow" },
    "markdownStrong": { "dark": "td_yellow", "light": "td_yellow" },
    "markdownHorizontalRule": { "dark": "td_muted", "light": "td_muted" },
    "markdownListItem": { "dark": "td_blue", "light": "td_blue" },
    "markdownListEnumeration": { "dark": "td_cyan", "light": "td_cyan" },
    "markdownImage": { "dark": "td_purple", "light": "td_purple" },
    "markdownImageText": { "dark": "td_cyan", "light": "td_cyan" },
    "markdownCodeBlock": { "dark": "td_fg", "light": "td_fg" },

    "syntaxComment": { "dark": "td_muted", "light": "td_muted" },
    "syntaxKeyword": { "dark": "td_purple", "light": "td_purple" },
    "syntaxFunction": { "dark": "td_blue", "light": "td_blue" },
    "syntaxVariable": { "dark": "td_cyan", "light": "td_cyan" },
    "syntaxString": { "dark": "td_green", "light": "td_green" },
    "syntaxNumber": { "dark": "td_orange", "light": "td_orange" },
    "syntaxType": { "dark": "td_cyan", "light": "td_cyan" },
    "syntaxOperator": { "dark": "td_blue", "light": "td_blue" },
    "syntaxPunctuation": { "dark": "td_fg", "light": "td_fg" }
  }
}
