{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "deny",
      "~/*": "allow",
      "~/.ssh/id_*": "deny",
      "~/.ssh/*.pem": "deny",
      "~/.ssh/authorized_keys": "deny",
      "~/.ssh/known_hosts": "deny"
    }
  },
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-flash",
  "share": "disabled",
  "autoupdate": "notify",
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "subagent_depth": 2,
  "lsp": true,
  "formatter": true,
  "agent": {
    "build": {
      "model": "deepseek/deepseek-v4-pro",
      "variant": "max",
      "temperature": 0.1,
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "plan": {
      "model": "deepseek/deepseek-flash",
      "variant": "default",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "general": {
      "description": "Use for complex multi-step sub-tasks needing deep reasoning: hard bugs, architecture, large refactors. Invoke when a task is too big to handle in the main flow. Can edit files.",
      "model": "deepseek/deepseek-v4-pro",
      "variant": "max"
    },
    "explore": {
      "description": "Use for codebase exploration: find files, functions, symbols, read code, answer questions about the repo. Fast, read-only. Do NOT use for writing code.",
      "model": "deepseek/deepseek-flash",
      "temperature": 0.0
    },
    "scout": {
      "description": "Use for external research: dependency source code, library docs, web pages. Read-only.",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash"
    }
  }
}
