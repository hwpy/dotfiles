{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "share": "disabled",
  "update": "notify",
  "formatter": false,
  "experimental": { "subagent_depth": 2 },
  "compaction": { "auto": true, "keep": { "tokens": 15000 } },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.ssh/id_*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/*.pem", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/authorized_keys", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/known_hosts", "effect": "deny" }
  ],
  "providers": {
    "deepseek": {
      "models": {
        "deepseek-v4-pro": { "body": { "temperature": 0.1 } },
        "deepseek-flash": {
          "body": { "temperature": 0.0 },
          "variants": [
            { "id": "default", "body": { "temperature": 0.1 } }
          ]
        }
      }
    }
  },
  "agents": {
    "title": { "model": "deepseek/deepseek-flash" },
    "build": {
      "model": "deepseek/deepseek-v4-pro#max",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "plan": {
      "model": "deepseek/deepseek-flash#default",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "general": {
      "description": "Use for complex multi-step sub-tasks needing deep reasoning: hard bugs, architecture, large refactors. Invoke when a task is too big to handle in the main flow. Can edit files.",
      "model": "deepseek/deepseek-v4-pro#max"
    },
    "explore": {
      "description": "Use for codebase exploration: find files, functions, symbols, read code, answer questions about the repo. Fast, read-only. Do NOT use for writing code.",
      "model": "deepseek/deepseek-flash"
    },
    "scout": {
      "description": "Use for external research: dependency source code, library docs, web pages. Read-only.",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash"
    }
  }
}
