[global]
background = "#0D1119"
frame_color = "#7AA2F7"
frame_width = 1
corner_radius = 15
foreground = "#C0CAF5"
font = "JetBrains Mono Nerd Font 10"
width = 350
origin = top-right
offset = (21, 21)

[urgency_normal]
background = "#0D1119"
foreground = "#C0CAF5"
timeout = 5

[urgency_low]
background = "#565F89"
foreground = "#C0CAF5"
timeout = 3

[urgency_critical]
background = "#F7768E"
foreground = "#C0CAF5"
timeout = 0

[play_sound]
summary = "*"
script = $HOME/.config/dunst/src/dunst-sound