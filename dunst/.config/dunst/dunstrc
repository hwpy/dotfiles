[global]
background = "#282C34"
frame_color = "#E7C787"
frame_width = 2
corner_radius = 10
foreground = "#ABB2BF"
font = "JetBrains Mono Nerd Font 10"
width = 300
origin = top-right
offset = (9, 42)

[urgency_normal]
background = "#282C34"
foreground = "#ABB2BF"
timeout = 5

[urgency_low]
background = "#5C6370"
foreground = "#ABB2BF"
timeout = 3

[urgency_critical]
background = "#FF75A0"
foreground = "#ABB2BF"
timeout = 0

[play_sound]
summary = "*"
script = $HOME/.config/dunst/src/dunst-sound
