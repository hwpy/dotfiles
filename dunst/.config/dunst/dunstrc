[global]
background = "#1A1B26"
frame_color = "#7aa2f7"
frame_width = 2
corner_radius = 10
foreground = "#A9B1D6"
font = "JetBrains Mono Nerd Font 10"
width = 300
origin = top-right
offset = (9, 42)

[urgency_normal]
background = "#1A1B26"
foreground = "#A9B1D6"
timeout = 5

[urgency_low]
background = "#414868"
foreground = "#A9B1D6"
timeout = 3

[urgency_critical]
background = "#ff75a0"
foreground = "#A9B1D6"
timeout = 0

[play_sound]
summary = "*"
script = $HOME/.config/dunst/src/dunst-sound
