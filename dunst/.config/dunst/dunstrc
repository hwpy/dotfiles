[global]
background = "#0F1419"
frame_color = "#746DFE"
frame_width = 2
corner_radius = 10
foreground = "#E6E6E6"
font = "JetBrains Mono Nerd Font 10"
width = 300
origin = top-right
offset = (9, 42)

[urgency_normal]
background = "#0F1419"
foreground = "#E6E6E6"
timeout = 5

[urgency_low]
background = "#424868"
foreground = "#E6E6E6"
timeout = 3

[urgency_critical]
background = "#FB3ECE"
foreground = "#E6E6E6"
timeout = 0

[play_sound]
summary = "*"
script = $HOME/.config/dunst/src/dunst-sound
